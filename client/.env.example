# API base URL.
# - Dev: keep /api (the Vite proxy forwards /api -> http://localhost:4000).
# - Production: the FULL URL of the API server with NO /api suffix (the API serves
#   its routes at the root, e.g. /event, /auth). Point it at the API host, NOT the
#   web app origin. Example:  VITE_API_BASE=https://api.booking.<div>.ivao.aero
VITE_API_BASE=/api
# IVAO OAuth (production SSO). Leave blank to use dev login locally.
VITE_IVAO_CLIENT_ID=
VITE_IVAO_REDIRECT_URI=http://localhost:5173/login/callback
