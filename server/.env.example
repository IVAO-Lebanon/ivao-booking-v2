# ─────────────────────────────────────────────────────────────────────────────
# LOCAL / development server env. Copy to `server/.env` for local work.
# For a live server use .env.production.example instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGINS=http://localhost:5173

# ── MySQL ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ivao
DB_PASSWORD=ivao
DB_NAME=ivao_booking
DB_CONNECTION_LIMIT=10

# ── Auth ───────────────────────────────────────────────
# Signs session tokens. Generate a strong value with:  openssl rand -hex 32
# In production the server REFUSES TO START if this is missing, contains
# "change-me", or is shorter than 32 characters.
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_EXPIRES_IN=24h

# Local dev-login endpoint (log in as any VID, no IVAO credentials needed).
# ALWAYS disabled when NODE_ENV=production, regardless of this value.
DEV_AUTH=true

# ── IVAO OAuth (production SSO) ─────────────────────────
IVAO_OPENID_CONFIG=https://api.ivao.aero/.well-known/openid-configuration
IVAO_API_ENDPOINT=https://api.ivao.aero/v2
IVAO_CLIENT_ID=
IVAO_CLIENT_SECRET=
IVAO_API_KEY=

# ── Admin authorization ────────────────────────────────
# Division whose staff can administer this instance (Lebanon).
IVAO_DIVISION=LB
# Comma-separated staff position patterns. A "0" acts as a numeric wildcard.
# e.g. LB-DIR, LB-AOC, LB-XA0 matches LB-XA1, LB-XA2 ...
AUTHORIZED_STAFF_POSITIONS=DIR,ADIR,AOC,AOAC,EC,AEC,WM,AWM,TC,ATC,FTC,AFTC,XA0

# ── Email (SMTP) ───────────────────────────────────────
# Where the app sends event emails from. Leave SMTP_HOST/SMTP_USER blank to run in
# "preview mode": emails are composed and logged but NOT actually delivered (handy
# for local dev). Set all of these to send for real.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The From header shown to pilots.
MAIL_FROM=BYBLOS <no-reply@ivao.aero>

# ── Booking rules ──────────────────────────────────────
# Days before an event that pilots may confirm a prebooked slot.
CONFIRM_MAX_DAYS_BEFORE=7
# Days before an event where slots auto-confirm (no manual confirm step).
AUTO_BOOK_WITHIN_DAYS=2
# Max event duration (hours).
MAX_EVENT_HOURS=10
