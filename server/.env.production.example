# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION server env. Copy to `server/.env` on the API host, fill CHANGE_ME,
# then restart the app. (For local development use .env.example instead.)
# Replace "lb" with your division where it appears.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=production

# Web app origin(s) allowed to call the API (CORS). No trailing slash.
CLIENT_ORIGINS=https://booking.lb.ivao.aero

# ── MySQL ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=lbivao_byblos
DB_CONNECTION_LIMIT=10

# ── Auth ───────────────────────────────────────────────
# Generate:  openssl rand -hex 32
# The server REFUSES TO START in production if this is weak/missing.
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
# Dev login is always disabled in production regardless of this value.
DEV_AUTH=false

# ── IVAO OAuth (SSO) ───────────────────────────────────
IVAO_OPENID_CONFIG=https://api.ivao.aero/.well-known/openid-configuration
IVAO_API_ENDPOINT=https://api.ivao.aero/v2
IVAO_CLIENT_ID=CHANGE_ME
IVAO_CLIENT_SECRET=CHANGE_ME
IVAO_API_KEY=CHANGE_ME

# ── Admin authorization ────────────────────────────────
IVAO_DIVISION=LB
AUTHORIZED_STAFF_POSITIONS=DIR,ADIR,AOC,AOAC,EC,AEC,WM,AWM,TC,ATC,FTC,AFTC,XA0

# ── Email (SMTP) ───────────────────────────────────────
# Use the mail server on the same box (localhost), NOT the public domain, which
# may be behind a proxy that does not pass SMTP. Quote any value containing "#".
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_SECURE=true
# localhost cert won't match the mailbox hostname, so accept it:
SMTP_ALLOW_INVALID_CERT=true
SMTP_USER=booking@lb.ivao.aero
SMTP_PASS="CHANGE_ME"
MAIL_FROM="BYBLOS <booking@lb.ivao.aero>"

# ── Booking rules ──────────────────────────────────────
CONFIRM_MAX_DAYS_BEFORE=7
AUTO_BOOK_WITHIN_DAYS=2
MAX_EVENT_HOURS=10
