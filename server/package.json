{
  "name": "ivao-lb-booking-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IVAO Lebanon Booking System — Node/Express + MySQL API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^9.0.3",
    "zod": "^3.23.8"
  }
}
